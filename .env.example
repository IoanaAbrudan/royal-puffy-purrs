NODE_ENV=development
# Set to your live domain when deploying, e.g. https://royalpuffypurrs.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CONTACT_EMAIL=cattery@royalpuffypurrs.com

# Google Search Console verification code (HTML tag method)
# Find this in Search Console → Settings → Ownership verification
GOOGLE_SITE_VERIFICATION=

# Admin seller login (server-only — never commit real passwords)
# All three are required for sign-in to work. In production AUTH_SECRET must be
# at least 16 characters, otherwise sign-in returns a 503 and logs which var is missing.
# Generate one with: openssl rand -base64 32
ADMIN_EMAIL=cattery@royalpuffypurrs.com
ADMIN_PASSWORD=change-this-password
AUTH_SECRET=replace-with-a-long-random-secret
